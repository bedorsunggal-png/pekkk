            display: flex;

            border-bottom: 1px solid var(--tokopedia-border);

            overflow-x: auto;

        }



        .tab {

            padding: 1rem 2rem;

            font-weight: 600;

            cursor: pointer;

            border-bottom: 3px solid transparent;

            transition: 0.2s;

            white-space: nowrap;

        }



        .tab.active {

            border-bottom-color: var(--tokopedia-green);

            color: var(--tokopedia-green);

        }



        .tab-content {

            padding: 2rem;

        }



        .tab-pane {

            display: none;

        }



        .tab-pane.active {

            display: block;

        }



