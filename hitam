            grid-template-columns: 1fr 1fr;

            gap: 2rem;

            background: #1B0B12;

            padding: 1.5rem;

            border-radius: 16px;

            box-shadow: 0 2px 8px rgba(242, 59, 85, 0.12);

            margin-bottom: 2rem;

        }



