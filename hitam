        .shipping-info {

            border: 1px solid var(--tokopedia-border);

            border-radius: 12px;

            padding: 1rem;

            margin: 1rem 0;

            width: 100%;

            min-width: 0;

            background: #281017;

        }



        .shipping-row {

            display: grid;

            grid-template-columns: 155px minmax(0, 1fr);

            align-items: start;

            gap: 16px;

            padding: 0.75rem 0;

            border-bottom: 1px solid rgba(242, 59, 85, .15);

        }



        .shipping-row:last-child {

            border-bottom: none;

        }



        .shipping-row>span:first-child {

            display: flex;

            align-items: center;

            gap: 8px;

            color: #F47D8F;

            font-weight: 600;

            white-space: nowrap;

        }



        .shipping-row>span:last-child {

            min-width: 0;

            color: #F6E9E5;

            line-height: 1.6;

            overflow-wrap: break-word;

        }



        .shipping-row i {

            flex-shrink: 0;

            color: #F23B55;

        }



        @media (max-width: 600px) {

            .shipping-row {

                grid-template-columns: 1fr;

                gap: 5px;

            }

            .shipping-row>span:first-child {

                white-space: normal;

            }

        }



