            display: flex;

            gap: 0.5rem;

            margin-top: 1rem;

            flex-wrap: wrap;

        }



        .thumbnail {

            width: 70px;

            height: 70px;

            border-radius: 8px;

            object-fit: cover;

            cursor: pointer;

            border: 2px solid transparent;

            transition: border 0.2s;

