        .wishlist-btn {

            background: #1B0B12;

            border: 2px solid var(--tokopedia-border);

            color: #F2A3A9;

            padding: 0.8rem 1.2rem;

            border-radius: 8px;

            cursor: pointer;

            font-size: 1.2rem;

            transition: 0.2s;

        }

        .wishlist-btn:hover {

            border-color: #F23B55;

            color: #F47D8F;

        }



        /* Seller info card */

        .seller-card {

            border: 1px solid var(--tokopedia-border);

            border-radius: 12px;

            padding: 1rem;

            margin: 1rem 0;

            background: #281017;

