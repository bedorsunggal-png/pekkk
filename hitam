        .price small {

            font-size: 1rem;

            font-weight: 400;

            color: #B79B9D;

            text-decoration: line-through;

            margin-left: 0.5rem;

        }



        .discount {

            background: #C52840;

            color: white;

            padding: 0.2rem 0.6rem;

            border-radius: 12px;

            font-size: 0.9rem;

            margin-left: 0.5rem;

        }



        .variants {

            margin: 1rem 0;

        }



        .variant-label {

            font-weight: 600;

            margin-bottom: 0.3rem;

        }



