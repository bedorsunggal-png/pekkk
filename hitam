            margin-left: auto;

            background: var(--tokopedia-green-light);

            border: 1px solid var(--tokopedia-green);

            color: var(--tokopedia-green);

            padding: 0.4rem 1rem;

            border-radius: 20px;

            cursor: pointer;

        }


