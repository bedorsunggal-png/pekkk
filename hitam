            display: flex;

            gap: 0.5rem;

            flex-wrap: wrap;

        }



        .variant-option {

            padding: 0.5rem 1rem;

            border: 1px solid var(--tokopedia-border);

            border-radius: 20px;

            cursor: pointer;

            background: #1B0B12;

            transition: all 0.2s;

        }



        .variant-option.selected {

            border-color: var(--tokopedia-green);

            background: var(--tokopedia-green-light);

        }



        /* Quantity selector */

        .quantity-selector {

            display: flex;

            align-items: center;

            gap: 0.5rem;

            margin: 1rem 0;

            flex-wrap: wrap;

        }



        .quantity-btn {

            width: 40px;

            height: 40px;

            border: 1px solid var(--tokopedia-border);

            background: #1B0B12;

            color: #F6E9E5;

            border-radius: 8px;

            font-size: 1.2rem;

            cursor: pointer;

        }



        .quantity-input {

            width: 60px;

            height: 40px;

            text-align: center;

            border: 1px solid var(--tokopedia-border);

            border-radius: 8px;

            background: #1B0B12;

            color: #F6E9E5;

        }



        .quantity-error {

            color: #F47D8F;

            font-size: 0.85rem;

            margin-left: 0.5rem;

        }



        .action-buttons {

            display: flex;

            gap: 1rem;

            margin: 1.5rem 0;

        }



        .btn {

            padding: 1rem 2rem;

            border: none;

            border-radius: 8px;

            font-size: 1rem;

            font-weight: 600;

            cursor: pointer;

            transition: 0.2s;

        }



        .btn-primary {

            background: var(--tokopedia-green);

            color: white;

            flex: 2;

        }



        .btn-primary:hover {

            background: #C52840;

        }



        .btn-outline {

            background: #1B0B12;

            border: 2px solid var(--tokopedia-green);

            color: var(--tokopedia-green);

            flex: 1;

        }



        .btn-outline:hover {

            background: var(--tokopedia-green-light);

        }



